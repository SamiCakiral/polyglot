  "compilerOptions": {
    "composite": true,
    "skipLibCheck": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "eslint.config.js",
    "orval.config.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}
