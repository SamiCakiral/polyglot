# Ports locaux non publics
POLYGLOT_HTTP_PORT=9001
POLYGLOT_POSTGRES_PORT=55432

# Remplacer chaque valeur avant un lancement manuel de Compose.
POLYGLOT_POSTGRES_PASSWORD=replace-with-a-long-random-secret
POLYGLOT_MIGRATION_DB_PASSWORD=replace-with-a-long-random-secret
POLYGLOT_RUNTIME_DB_PASSWORD=replace-with-a-long-random-secret
POLYGLOT_RETENTION_DB_PASSWORD=replace-with-a-long-random-secret
POLYGLOT_SESSION_SECRET=replace-with-a-long-random-secret
POLYGLOT_MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret

# Depuis le conteneur backend, cette adresse désigne LM Studio sur la machine.
POLYGLOT_LM_STUDIO_URL=http://host.docker.internal:1234
