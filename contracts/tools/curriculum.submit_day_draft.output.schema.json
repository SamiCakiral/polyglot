{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "curriculum.submit_day_draft output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "day_draft",
    "reference_plans",
    "budget_validation",
    "observable_targets",
    "checksum"
  ],
  "properties": {
    "day_draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "reference_plans": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "budget_validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "observable_targets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "checksum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  }
}
