{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catalogue.list_targets output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets",
    "next_cursor"
  ],
  "properties": {
    "targets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  }
}
