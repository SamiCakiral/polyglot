{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets",
    "next_cursor",
    "stable"
  ],
  "properties": {
    "targets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 128
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 20000
    },
    "stable": {
      "type": "boolean",
      "enum": [
        true
      ]
    }
  }
}
