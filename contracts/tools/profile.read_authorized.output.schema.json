{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "field_groups",
    "pseudonymized",
    "cutoff"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "field_groups": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 32
      }
    },
    "pseudonymized": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "cutoff": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
