{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validation_report_id",
    "decision",
    "findings",
    "report_truncated"
  ],
  "properties": {
    "validation_report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "enum": [
        "passed",
        "failed",
        "human_required"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 128
      }
    },
    "report_truncated": {
      "type": "boolean"
    }
  }
}
