{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality.report_ambiguity input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_ref",
    "resource_revision_id",
    "ambiguity_type",
    "location",
    "description",
    "candidate_interpretations",
    "private_context_consent"
  ],
  "properties": {
    "resource_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "resource_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "ambiguity_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "candidate_interpretations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "private_context_consent": {
      "type": "boolean"
    }
  }
}
