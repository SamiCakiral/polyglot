{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation_id",
    "reason_codes",
    "facts",
    "alternatives"
  ],
  "properties": {
    "recommendation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 128
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 20000
      }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 20000
      }
    }
  }
}
