{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "progress.explain_recommendation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reason",
    "targets",
    "authorized_facts",
    "policy",
    "alternatives",
    "disappearance_conditions"
  ],
  "properties": {
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "targets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "authorized_facts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "alternatives": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "disappearance_conditions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    }
  }
}
