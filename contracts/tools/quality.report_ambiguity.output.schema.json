{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quality_report_id",
    "status",
    "visibility",
    "deduplication_fingerprint"
  ],
  "properties": {
    "quality_report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "enum": [
        "open"
      ]
    },
    "visibility": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "enum": [
        "private",
        "editorial"
      ]
    },
    "deduplication_fingerprint": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
