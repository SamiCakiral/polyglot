{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_id",
    "draft_type",
    "revision",
    "status",
    "findings",
    "checksum",
    "publish_capability",
    "mastery_capability"
  ],
  "properties": {
    "draft_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "draft_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "enum": [
        "exercise"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "enum": [
        "draft"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 128
      }
    },
    "checksum": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "publish_capability": {
      "type": "boolean",
      "enum": [
        false
      ]
    },
    "mastery_capability": {
      "type": "boolean",
      "enum": [
        false
      ]
    }
  }
}
