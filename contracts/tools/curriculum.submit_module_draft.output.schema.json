{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "curriculum.submit_module_draft output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_draft",
    "resolved_graph",
    "total_load",
    "findings",
    "checksum"
  ],
  "properties": {
    "module_draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "resolved_graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "total_load": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "checksum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  }
}
