{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "curriculum.submit_day_draft input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_draft_id",
    "ordinal",
    "arc",
    "context",
    "objectives",
    "novelty",
    "reviews",
    "next_day_needs",
    "lists",
    "compositions",
    "provenance",
    "expected_version"
  ],
  "properties": {
    "module_draft_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31
    },
    "arc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "objectives": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "novelty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "reviews": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "next_day_needs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "lists": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "compositions": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  }
}
