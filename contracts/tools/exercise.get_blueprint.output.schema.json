{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primitive_id",
    "contract_version",
    "correction_strategies",
    "publish_capability"
  ],
  "properties": {
    "primitive_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "correction_strategies": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 128
      }
    },
    "publish_capability": {
      "type": "boolean",
      "enum": [
        false
      ]
    }
  }
}
