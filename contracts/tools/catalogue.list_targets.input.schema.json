{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catalogue.list_targets input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_revision_id"
  ],
  "properties": {
    "pack_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "target_types": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "modality": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "prerequisite_of": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "status": {
      "type": "string",
      "enum": [
        "published"
      ],
      "maxLength": 16
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
