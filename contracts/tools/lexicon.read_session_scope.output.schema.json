{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "senses",
    "snapshot_id"
  ],
  "properties": {
    "senses": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 128
      }
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  }
}
