{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lexicon.read_session_scope input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "planning_snapshot_id",
    "roles",
    "target_refs",
    "list_snapshot_ids",
    "max_senses"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "planning_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "roles": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "target_refs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "list_snapshot_ids": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "max_senses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
