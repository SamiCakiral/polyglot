            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LiveStatus",
        "type": "object"
      },
      "PreferencesRequest": {
        "additionalProperties": false,
        "properties": {
          "accessibility_preferences": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue-Input"
