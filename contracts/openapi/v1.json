          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "day_cutover_local_time": {
            "title": "Day Cutover Local Time",
            "type": "string"
          },
          "interface_locale": {
            "title": "Interface Locale",
            "type": "string"
          },
          "media_preferences": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue-Output"
            },
            "title": "Media Preferences",
            "type": "object"
          },
          "preferred_sprint_minutes": {
            "title": "Preferred Sprint Minutes",
            "type": "integer"
          },
          "timezone": {
            "title": "Timezone",
