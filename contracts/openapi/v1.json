          {
            "items": {
              "$ref": "#/components/schemas/JsonValue-Output"
            },
            "type": "array"
          },
          {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue-Output"
            },
            "type": "object"
          }
        ]
      },
      "LiveStatus": {
        "properties": {
          "status": {
            "const": "ok",
